# Variables d'environnement pour le frontend statique
# Note : Aucune clé secrète ne doit figurer dans cette application frontend statique.

# URL canonique du site déployé (utilisée pour les métadonnées SEO et le sitemap)
VITE_SITE_URL=https://aoudou-sehou.vercel.app

# Adresse e-mail officielle affichée
VITE_CONTACT_EMAIL=aoudousehou@gmail.com

# Identifiant public de formulaire Formspree (optionnel)
# Créez gratuitement un formulaire sur https://formspree.io et collez ici son code (ex: "xvgowpqk")
# Laissez vide pour activer automatiquement le mode sécurisé mailto direct sans faux succès.
VITE_FORMSPREE_FORM_ID=
